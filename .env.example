# SAP Azure→GCP Migration — environment variables
# Copy to .env and fill in real values (never commit .env):
#   cp .env.example .env
# Load before running scripts:
#   source scripts/load-env.sh

# ─── AAP Controller ───────────────────────────────────────────────────────────
CONTROLLER_HOST=https://34.205.23.227
# Preferred: OAuth token (Settings → Tokens in AAP UI)
CONTROLLER_OAUTH_TOKEN=
# Fallback: username/password (if no OAuth token)
CONTROLLER_USERNAME=admin
CONTROLLER_PASSWORD=
# Set false for self-signed / IP-based controllers
AAP_VERIFY_SSL=false
AAP_ORGANIZATION=Default

# ─── Execution Environment ────────────────────────────────────────────────────
# Registry where sap-migration-ee will be pushed
AAP_EE_REGISTRY=34.205.23.227
AAP_EE_NAME=sap-migration-ee
AAP_EE_IMAGE=34.205.23.227/demo/sap-migration-ee:latest
# Base image on the controller's internal registry
AAP_EE_BASE_IMAGE=34.205.23.227/ee-minimal-rhel9:latest

# ─── Automation Hub (certified collections for EE build) ─────────────────────
ANSIBLE_GALAXY_SERVER_AUTOMATION_HUB_TOKEN=

# ─── Azure credentials ────────────────────────────────────────────────────────
# az account show
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# Optional — leave empty when using az login locally
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Match RG/region where azure_add_workloads.sh provisioned VMs (e.g. sap-migration-dev-wu2 / westus2)
AZURE_RESOURCE_GROUP=sap-migration-dev-wu2
AZURE_LOCATION=westus2

# ─── GCP credentials ─────────────────────────────────────────────────────────
# ADC after: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json
GCP_AUTH_KIND=application
# Or service account JSON: GCP_AUTH_KIND=serviceaccount
# GCP_SERVICE_ACCOUNT_FILE=~/.gcp/sap-migration-sa.json
# GCP project ID (e.g. my-project-123456), not the Console display name
GCP_PROJECT=
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# ─── SSH (builder / SAP hosts) ───────────────────────────────────────────────
SSH_PRIVATE_KEY_FILE=~/.ssh/sap_migration_id_rsa
SSH_USERNAME=azureuser

# ─── SAP migration parameters (used as workflow survey defaults) ──────────────
SAP_SID=DEV
SAP_INSTANCE_NR=00
SAP_DATABASE_TYPE=db2
SAP_DB2_INSTANCE=db2inst1
SAP_HANA_INSTANCE_NR=00
MIGRATION_NAME=sap-migration-demo
